generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  customCategories Json? @default("{\"EXPENSE\": [], \"INCOME\": [], \"categoryIcons\": {}}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  splitBills SplitBill[]
  wishlists Wishlist[]
  transactions Transaction[]
  wallets    Wallet[]
  budgets    Budget[]
  recurringTransactions RecurringTransaction[]
  debts      Debt[]
}

model Transaction {
  id        Int             @id @default(autoincrement())
  userId    Int
  type      TransactionType
  amount    Int
  category  String?
  note      String?
  receiptImage String?
  receiptImageName String?
  walletId  Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet    Wallet?         @relation(fields: [walletId], references: [id], onDelete: SetNull)
  splitBills SplitBill[]
  memberPayments SplitBillMember[] @relation("PaymentTransaction")

  @@index([userId, createdAt])
  @@index([userId, type])
}

model Wishlist {
  id            Int      @id @default(autoincrement())
  userId        Int
  item          String
  price         Int
  currentSaved  Int      @default(0)
  priorityScore Int      @default(3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, priorityScore, createdAt])
}

model SplitBill {
  id              Int                      @id @default(autoincrement())
  userId          Int
  title           String
  description     String?
  totalAmount     Int
  divisionMethod  SplitBillDivisionMethod  @default(CUSTOM)
  status          SplitBillStatus          @default(UNPAID)
  syncToPersonal  Boolean                  @default(false)
  transactionId   Int?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  members         SplitBillMember[]
  items           SplitBillItem[]
  transaction     Transaction?             @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([transactionId])
}

model SplitBillMember {
  id          Int                   @id @default(autoincrement())
  splitBillId Int
  friendName  String
  amount      Int
  status      SplitBillMemberStatus @default(UNPAID)
  isUser      Boolean               @default(false)
  paidAt      DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  splitBill   SplitBill             @relation(fields: [splitBillId], references: [id], onDelete: Cascade)
  itemAssignments SplitBillItemAssignment[]
  paymentTxId Int?
  paymentTx   Transaction?          @relation("PaymentTransaction", fields: [paymentTxId], references: [id], onDelete: SetNull)

  @@index([splitBillId, status])
}

model SplitBillItem {
  id          Int       @id @default(autoincrement())
  splitBillId Int
  itemName    String
  price       Int
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  splitBill   SplitBill @relation(fields: [splitBillId], references: [id], onDelete: Cascade)
  assignedTo  SplitBillItemAssignment[]

  @@index([splitBillId])
}

model SplitBillItemAssignment {
  id       Int              @id @default(autoincrement())
  itemId   Int
  memberId Int
  item     SplitBillItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  member   SplitBillMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([itemId, memberId])
  @@index([memberId])
}

model Contact {
  id        Int      @id @default(autoincrement())
  reference String   @unique
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

enum SplitBillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum SplitBillMemberStatus {
  UNPAID
  PAID
}

enum SplitBillDivisionMethod {
  EQUAL
  CUSTOM
  ITEM_BASED
}


enum TransactionType {
  INCOME
  EXPENSE
  SHARED_EXPENSE
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  balance   Int      @default(0)
  type      WalletType @default(CASH)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
}

model Budget {
  id        Int      @id @default(autoincrement())
  userId    Int
  category  String
  amount    Int
  month     Int      
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month, year])
  @@unique([userId, category, month, year])
}

model RecurringTransaction {
  id            Int      @id @default(autoincrement())
  userId        Int
  walletId      Int
  type          TransactionType
  amount        Int
  category      String?
  note          String?
  interval      RecurringInterval
  nextOccurrence DateTime
  status        RecurringStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, nextOccurrence])
}

model Debt {
  id          Int      @id @default(autoincrement())
  userId      Int
  personName  String
  amount      Int
  type        DebtType
  status      DebtStatus @default(UNPAID)
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum WalletType {
  CASH
  BANK
  EWALLET
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
}

enum DebtType {
  DEBT
  LOAN
}

enum DebtStatus {
  UNPAID
  PAID
}
